{
  "description": "Redline: open the plan in a browser review UI when Claude calls ExitPlanMode.",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/redline.js\" plan-hook",
            "timeout": 345600
          }
        ]
      }
    ]
  }
}
